[Unit]
Description=computeMCP gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# --config is omitted on purpose: the gateway defaults to
# %h/.config/computeMCP-gateway/config.toml (and its sibling tokens.toml).
# Call the venv binary directly: systemd does not run a shell, so the venv is
# not "activated" and there is no ~/.local/bin symlink to rely on.
ExecStart=%h/.local/share/computeMCP-gateway/venv/bin/computeMCP-gateway --no-console
# `systemctl --user reload computeMCP-gateway` re-reads the config and
# token file without dropping live tunnels.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
# The service must never run as root.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
