[Unit]
Description=Terok Compute Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/terok-compute-gateway --config %h/.config/terok-compute-gateway/config.toml --no-console
# `systemctl --user reload terok-compute-gateway` re-reads the config and
# token file without dropping live tunnels.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
# The service must never run as root.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
